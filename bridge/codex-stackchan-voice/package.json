{
  "name": "@stack-chan/codex-voice-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Bridge Stack-chan USB audio and approval events to Codex app-server realtime.",
  "type": "module",
  "bin": {
    "stackchan-codex-voice": "./dist/src/cli.js",
    "stackchan-codex-voice-install-service": "./dist/src/service/install-user-service.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/patch-werift-consent.mjs",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.json",
    "postbuild": "node scripts/make-cli-executable.mjs",
    "clean": "rm -rf dist",
    "generate:codex-types": "node scripts/generate-codex-types.mjs",
    "install:user-service": "node dist/src/service/install-user-service.js",
    "test": "npm run test:node && npm run test:vitest",
    "test:node": "npm run build && node --test \"dist/**/*.test.js\"",
    "test:vitest": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "serialport": "^13.0.0",
    "werift": "0.24.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
